# SQL Server Configuration
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=YourPassword123
DB_NAME=Data_PersonalizedSystem

# Server Configuration
PORT=3001

# Email Configuration (Mailjet Transactional API)
# Note: Using Mailjet API instead of SMTP to avoid firewall blocking on cloud platforms
MAILJET_API_KEY=<YOUR_MAILJET_API_KEY>
MAILJET_SECRET_KEY=<YOUR_MAILJET_SECRET_KEY>
# Fallback to SMTP_USER/SMTP_PASS if MAILJET_API_KEY/SECRET_KEY not set
SMTP_USER=<MAILJET_API_KEY>
SMTP_PASS=<MAILJET_SECRET_KEY>
EMAIL_FROM=no-reply@learn-dashboard.shopsheap.online

# Frontend URL
FRONTEND_URL=http://localhost:5173

